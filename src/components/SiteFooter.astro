---
import { siteLinks } from "@/lib/site-data"
---

<footer class="border-t border-white/8 px-6 py-10">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-6 text-sm text-[var(--color-muted)] md:flex-row md:items-end md:justify-between">
    <div class="space-y-2">
      <p class="font-[family-name:var(--font-display)] text-2xl uppercase tracking-[0.18em] text-white">
        Samuel Swedberg
      </p>
      <p>Computer engineering portfolio focused on hardware, firmware, and systems design.</p>
    </div>

    <div class="flex flex-wrap gap-4">
      <a href={siteLinks.github} class="hover:text-white">GitHub</a>
      <a href={siteLinks.linkedin} class="hover:text-white">LinkedIn</a>
    </div>
  </div>
</footer>
