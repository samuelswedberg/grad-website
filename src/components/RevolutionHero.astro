---
interface NavLink {
  text: string
  href: string
  gradient: string
  shimmer?: boolean
}

interface Props {
  eyebrow?: string[]
  navLinks?: NavLink[]
  siteLabel?: string
}

const {
  eyebrow = ["Break the boundaries,", "Unleash your potential"],
  navLinks = [
    { text: "IGNITE", href: "/ignite", gradient: "linear-gradient(135deg, #ffeedd, #cccccc)" },
    { text: "TRANSFORM", href: "/transform", gradient: "linear-gradient(135deg, #ffeedd, #cccccc)" },
    { text: "DOMINATE", href: "/dominate", gradient: "linear-gradient(135deg, #ffeedd, #cccccc)" },
    { text: "EVOLVE", href: "/evolve", gradient: "linear-gradient(135deg, #ffeedd, #cccccc)" },
  ],
  siteLabel = "samuelswedberg.com",
} = Astro.props
---

<section class="hero-section">
  <!-- VHS background layers -->
  <div class="vhs-bg" aria-hidden="true">
    <div class="vhs-bars"></div>
    <div class="vhs-interference"></div>
    <div class="vhs-head-switch"></div>
    <div class="vhs-chroma-bleed"></div>
  </div>
  <div class="hero-inner">
    <div class="hero-eyebrow">
      {eyebrow.map((line) => (
        <p>{line}</p>
      ))}
    </div>

    <div class="hero-bottom">
      <nav class="hero-nav">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={["hero-nav-link", "crt-text", link.shimmer && "hero-nav-shimmer"]}
            target={link.href.startsWith("http") ? "_blank" : undefined}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
            style={`--link-gradient: ${link.gradient}; ${link.shimmer ? "background-size: 180% 180%; background-position: 50% 50%;" : ""}`}
          >
            {link.text}
          </a>
        ))}
      </nav>

      <div class="hero-quotes">
        <p class="quote-primary">Engineer. Creator. Builder.</p>
        <p class="quote-secondary">Jack of all trades, master of the ones that matter</p>
        <p class="quote-secondary">I go wherever curiosity and hard problems take me</p>
        <p class="quote-secondary">
          Currently building
          <a
            href="https://goodevening.tv"
            target="_blank"
            rel="noreferrer"
            class="forge-link hero-nav-shimmer"
          >
            GoodEvening.tv
          </a>
        </p>
        <p class="quote-secondary">Projects, links, and case studies live in the nav.</p>
        <p class="hero-site-label">{siteLabel}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    animation: vhs-tracking 25s linear infinite;
  }

  /* ── VHS Background ── */

  .vhs-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  /* Slow drifting horizontal color bands — like paused VHS tape */
  .vhs-bars {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        180deg,
        transparent 0px,
        rgba(255, 120, 20, 0.025) 2px,
        transparent 4px,
        transparent 40px,
        rgba(255, 179, 71, 0.03) 42px,
        transparent 44px,
        transparent 80px,
        rgba(255, 80, 0, 0.02) 82px,
        transparent 84px,
        transparent 120px
      ),
      repeating-linear-gradient(
        180deg,
        transparent 0px,
        transparent 200px,
        rgba(255, 160, 40, 0.04) 200px,
        rgba(255, 160, 40, 0.04) 202px,
        transparent 204px,
        transparent 350px,
        rgba(255, 100, 0, 0.03) 350px,
        rgba(255, 100, 0, 0.03) 351px,
        transparent 353px,
        transparent 500px
      );
    animation: vhs-bars-drift 20s linear infinite;
  }

  /* Interference — horizontal noise bands that scroll through */
  .vhs-interference {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        180deg,
        transparent 0px,
        transparent 3px,
        rgba(255, 179, 71, 0.015) 3px,
        rgba(255, 179, 71, 0.015) 4px,
        transparent 4px,
        transparent 7px
      );
    animation: vhs-interference-scroll 3s linear infinite;
    opacity: 0.8;
  }

  /* Head-switch noise — the bright distortion band at the bottom of the frame */
  .vhs-head-switch {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 12px;
    z-index: 2;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 140, 40, 0.12) 10%,
      rgba(255, 200, 80, 0.08) 20%,
      transparent 30%,
      rgba(255, 120, 20, 0.15) 50%,
      transparent 65%,
      rgba(255, 179, 71, 0.1) 80%,
      transparent 100%
    );
    animation: head-switch-jitter 0.3s steps(3) infinite;
    mix-blend-mode: screen;
  }

  /* Chroma bleed — wide slow-moving color wash bands */
  .vhs-chroma-bleed {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      rgba(255, 80, 0, 0.02) 15%,
      transparent 25%,
      rgba(255, 200, 60, 0.025) 40%,
      transparent 50%,
      rgba(255, 120, 20, 0.02) 65%,
      transparent 75%,
      rgba(255, 160, 40, 0.03) 90%,
      transparent 100%
    );
    animation: chroma-drift 15s ease-in-out infinite alternate;
    mix-blend-mode: screen;
  }

  @keyframes vhs-bars-drift {
    0%   { transform: translateY(0); }
    100% { transform: translateY(-500px); }
  }

  @keyframes vhs-interference-scroll {
    0%   { transform: translateY(0); }
    100% { transform: translateY(100px); }
  }

  @keyframes head-switch-jitter {
    0%   { transform: translateX(0); opacity: 0.8; }
    33%  { transform: translateX(3px); opacity: 1; }
    66%  { transform: translateX(-2px); opacity: 0.6; }
    100% { transform: translateX(1px); opacity: 0.9; }
  }

  @keyframes chroma-drift {
    0%   { transform: translateY(0) scaleY(1); }
    50%  { transform: translateY(60px) scaleY(1.15); }
    100% { transform: translateY(-40px) scaleY(0.9); }
  }

  @media (prefers-reduced-motion: reduce) {
    .vhs-bars,
    .vhs-interference,
    .vhs-head-switch,
    .vhs-chroma-bleed {
      animation: none;
    }
  }

  /* ── Content ── */

  .hero-inner {
    position: relative;
    z-index: 10;
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    padding: 2rem;
  }

  @media (min-width: 768px) {
    .hero-inner {
      padding: 3rem;
    }
  }

  .hero-eyebrow p {
    font-family: "Segoe UI", sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }

  @media (min-width: 768px) {
    .hero-eyebrow p {
      font-size: 1rem;
    }
  }

  .hero-bottom {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-end;
  }

  @media (min-width: 768px) {
    .hero-bottom {
      flex-direction: row;
    }
  }

  .hero-nav {
    margin-bottom: 2rem;
    text-align: left;
  }

  @media (min-width: 768px) {
    .hero-nav {
      margin-bottom: 0;
    }
  }

  .hero-nav-link {
    display: block;
    margin-bottom: 1.25rem;
    cursor: pointer;
    font-family: "Segoe UI", sans-serif;
    font-size: 2.7rem;
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: 0.02em;
    background: var(--link-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow:
      0.7px 0 0 rgba(255, 100, 0, 0.3),
      -0.7px 0 0 rgba(255, 200, 50, 0.3);
    transform: scale(1) rotateX(0deg) translateZ(0px);
    transition: transform 0.5s cubic-bezier(0.33, 1, 0.68, 1),
                text-shadow 0.4s cubic-bezier(0.33, 1, 0.68, 1),
                filter 0.4s ease;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .hero-nav-link:hover {
    transform: scale(1.05) rotateX(-2deg) translateZ(20px);
    text-shadow:
      0 5px 20px rgba(255, 179, 71, 0.3),
      0 0 18px rgba(255, 179, 71, 0.15),
      0.7px 0 0 rgba(255, 100, 0, 0.3),
      -0.7px 0 0 rgba(255, 200, 50, 0.3);
    z-index: 10;
  }

  @media (min-width: 768px) {
    .hero-nav-link {
      margin-bottom: 1.5rem;
      font-size: 4.35rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-nav-link {
      font-size: 6.8rem;
    }
  }

  .hero-quotes {
    max-width: 20rem;
    text-align: right;
    font-family: "Segoe UI", sans-serif;
    font-size: 0.75rem;
  }

  @media (min-width: 768px) {
    .hero-quotes {
      font-size: 0.875rem;
    }
  }

  .quote-primary {
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .quote-secondary {
    margin-bottom: 0.5rem;
    color: var(--color-muted);
  }

  .forge-link {
    display: inline-block;
    font-weight: 600;
    background: linear-gradient(90deg, rgb(255 139 26) 0%, rgb(255 179 71) 100%);
    background-size: 19ch 100%;
    background-position: center;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-site-label {
    margin-top: 1.5rem;
    font-weight: 700;
    background: linear-gradient(to right, var(--color-warm), var(--color-accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-section {
      animation: none;
    }

    .hero-nav-link {
      transition: none;
    }
  }
</style>
